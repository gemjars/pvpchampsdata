{
  "name": "kit-tournament-tracker",
  "version": "1.0.0",
  "description": "Webpage app to record and view kit tournament match results, stored in a JSON file.",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "pkg . --targets node20-win-x64 --output dist/kit-tournament-tracker.exe"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.16.1"
  },
  "pkg": {
    "assets": [
      "index.html",
      "styles.css",
      "app.js",
      "data/matches.json"
    ],
    "targets": [
      "node20-win-x64"
    ],
    "outputPath": "dist"
  }
}
